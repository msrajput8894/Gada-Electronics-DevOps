services:
  app:
    image: {{ app_image }}:${APP_VERSION}
    restart: unless-stopped
    env_file: app.env
    environment:
      APP_VERSION: ${APP_VERSION}

  nginx:
    image: nginx:1.27-alpine
    restart: unless-stopped
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      app:
        condition: service_healthy
