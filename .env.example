# Copy to .env for local use (never commit .env). In real environments these are
# injected by the platform: systemd, Docker, Kubernetes secrets, AWS Secrets Manager.

NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/gada_electronics

# Required when NODE_ENV=production. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Shown by /health so you can see which release is running.
APP_VERSION=dev

# Used by "npm run seed". There is no default password in production.
ADMIN_EMAIL=admin@gada.local
ADMIN_PASSWORD=ChangeMe123!

# Online payments are off by default; the demo checkout places orders without payment.
PAYMENTS_ENABLED=false

# Placeholders only. Replace with Razorpay Test Mode keys before enabling payments.
# Never use live credentials in local development or commit credentials to source control.
RAZORPAY_KEY_ID=replace_with_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_key_secret
